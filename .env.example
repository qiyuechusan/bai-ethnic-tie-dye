# Spring Boot
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=mysql

# MySQL
DB_URL=jdbc:mysql://localhost:3306/baizu_tiedye?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# Authentication and uploads
REQUIRE_LOGIN=true
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# DashScope / Qwen
AI_MODE=auto
DASHSCOPE_API_KEY=change-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_NATIVE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_ENABLE_THINKING=false

# Set this to true only for a local, offline demonstration.
AI_ALLOW_OFFLINE_FALLBACK=false

# Protects POST /api/admin/rag/reindex. Leave empty to disable the endpoint.
RAG_REINDEX_TOKEN=change-me
